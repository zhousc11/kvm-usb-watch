<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.example.kvm-usb-watch</string>
  <key>ProgramArguments</key><array><string>/usr/bin/python3</string><string>__HOME__/bin/kvm-usb-watch.py</string></array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>LimitLoadToSessionType</key><string>Aqua</string>
  <key>StandardOutPath</key><string>__HOME__/Library/Logs/kvm-usb-watch.stderr.log</string>
  <key>StandardErrorPath</key><string>__HOME__/Library/Logs/kvm-usb-watch.stderr.log</string>
</dict></plist>
